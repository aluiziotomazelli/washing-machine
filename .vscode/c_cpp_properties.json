{
  "configurations": [
    {
      "name": "Arduino-AVR",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/src/**",
        "${env:HOME}/.arduino15/packages/arduino/hardware/avr/**/cores/arduino",
        "${env:HOME}/.arduino15/packages/arduino/hardware/avr/**/variants/eightanaloginputs",
        "${env:HOME}/.arduino15/packages/arduino/hardware/avr/**/libraries/**",
        "${env:HOME}/Arduino/libraries/**"
      ],
      "defines": [
        "USBCON",
        "ARDUINO=10808",
        "ARDUINO_AVR_NANO",
        "F_CPU=16000000L"
      ],
      "compilerPath": "${env:HOME}/.arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/bin/avr-gcc",
      "cStandard": "c11",
      "cppStandard": "c++14",
      "intelliSenseMode": "linux-gcc-x86"
    },
    {
      "name": "Linux-Host-Tests",
      "includePath": [
        "${workspaceFolder}/src/**",
        "${workspaceFolder}/test/**"
      ],
      "defines": [
        "HOST_TEST"
      ],
      "compilerPath": "/usr/bin/g++",
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "linux-gcc-x64"
    }
  ],
  "version": 4
}
