# ==============================================================================
# Doxyfile for consolidated Markdown API generation
# Input: public headers under src/
# Output: build/docs/doxygen/xml -> API.md
# ==============================================================================

# Project configuration
PROJECT_NAME           = "Washing Machine Controller"
PROJECT_BRIEF          = "Custom ATmega328P washing machine controller firmware"
PROJECT_NUMBER         = "v0.7.0"
OUTPUT_DIRECTORY       = "build/docs/doxygen"
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES

# Input files (public API headers)
INPUT                  = src
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.h
EXTENSION_MAPPING      = hpp=C++ h=C++

# Extraction settings
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = YES
CASE_SENSE_NAMES       = YES

# Preprocessor and parser
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = src

# Warnings
QUIET                  = YES
WARNINGS               = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO

# Output formats (XML only, consumed by generate_api_md.py)
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_DOCBOOK       = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
